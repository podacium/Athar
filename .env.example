# Cloud SQL (PostgreSQL) runtime variables injected by AI Studio / deployment environment
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Application session signing secret (server-side only)
AUTH_SECRET=

# Localization & Mock Service Flags
DEFAULT_LOCALE=ar
USE_MOCK_BLOCKCHAIN=true
USE_MOCK_PAYMENTS=true
USE_MOCK_LOGISTICS=true
USE_MOCK_NOTIFICATIONS=true
USE_MOCK_UPLOADS=true

# App URL
APP_URL="http://localhost:3000"
